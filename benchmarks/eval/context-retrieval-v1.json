{
  "schema_version": 1,
  "id": "minecraft-java8-context-retrieval",
  "version": "1.0.0",
  "description": "Reproducible read-only evaluation of OpticCode context and retrieval strategies for Java 8, Bukkit 1.8.8, legacy APIs, and project configuration.",
  "fixtures": {
    "java_index": { "kind": "versioned", "path": "../java-index-mini" },
    "mini_bukkit": { "kind": "versioned", "path": "../mini-bukkit-plugin" },
    "legacy_edits": { "kind": "versioned", "path": "../java-edits-legacy" },
    "legacy_compile": { "kind": "versioned", "path": "../java-legacy-compile" },
    "gradle_plugin": { "kind": "versioned", "path": "../eval-gradle-plugin" },
    "pandaspigot_external": {
      "kind": "external",
      "external_id": "pandaspigot",
      "description": "Optional read-only PandaSpigot checkout supplied at runtime"
    },
    "kspawners_external": {
      "kind": "external",
      "external_id": "kspawners",
      "description": "Optional read-only Kspawners checkout supplied at runtime"
    }
  },
  "cases": [
    {
      "id": "exact-helpers-create-string",
      "category": "exact_symbol",
      "prompt": "Inspect dev.opticcode.util.Helpers#create(String).",
      "fixture": "java_index",
      "exact_query": "create(String",
      "expected": {
        "relevant_files": ["src/main/java/dev/opticcode/util/Helpers.java"],
        "relevant_symbols": ["dev.opticcode.util.Helpers#create(String)"],
        "irrelevant_files": ["src/main/java/dev/opticcode/alpha/Duplicate.java"],
        "facts": ["create returns the supplied value"],
        "forbidden_claims": ["create always returns READY"]
      },
      "tags": ["method", "overload"],
      "reason": "Measures exact overloaded method selection."
    },
